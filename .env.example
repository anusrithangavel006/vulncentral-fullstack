# Copy to .env (never commit .env)
PORT=8080
# Enables POST /api/admin/ingest (send header: Authorization: Bearer <token>)
ADMIN_TOKEN=change-me-to-a-long-random-string
# true = fetch CISA KEV + NVD on start and every 6 hours
AUTO_INGEST=false
# Optional: higher NVD rate limits (free key from nvd.nist.gov)
NVD_API_KEY=
# Optional: enables LLM-written answers in the assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Restrict browser origins when the frontend is hosted separately
CORS_ORIGIN=
